{
  "manifest_version": 2,
  "id": "github.BUNNY-19C.class-schedule",
  "version": "1.0.0",
  "name": "课程表提醒",
  "description": "导入课表 ICS 文件，在上课前自定义分钟数（默认 20 分钟）主动推送上课提醒",
  "author": {
    "name": "BUNNY-19C",
    "url": "https://github.com/BUNNY-19C"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/BUNNY-19C/maibot-class_schedule-plugin",
    "homepage": "https://github.com/BUNNY-19C/maibot-class_schedule-plugin",
    "documentation": "https://github.com/BUNNY-19C/maibot-class_schedule-plugin/blob/main/README.md",
    "issues": "https://github.com/BUNNY-19C/maibot-class_schedule-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "python-dateutil",
      "version_spec": ">=2.8.0"
    }
  ],
  "plugin_type": "tool",
  "capabilities": [
    "send.text",
    "chat.get_stream_by_user_id",
    "maisaka.proactive.trigger",
    "message.get_recent",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
